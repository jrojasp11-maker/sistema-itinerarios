{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/(.*)\\.(js|css|svg|png|webmanifest|json)", "destination": "/frontend/$1.$2" },
    { "source": "/(.*)", "destination": "/frontend/" }
  ]
}
